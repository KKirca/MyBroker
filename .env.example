# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Claude API (persona / sinyal yorumlama) ---
ANTHROPIC_API_KEY=

# --- Alpaca (ABD hisseleri) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true

# --- BIST (İş Yatırım AlgoLab veya alternatif) ---
ALGOLAB_USERNAME=
ALGOLAB_PASSWORD=
ALGOLAB_API_KEY=
# signal_only  -> sadece Telegram'a bildirim, emir gönderilmez (önerilen varsayılan)
# manual_confirm -> Telegram'dan onay gelirse emir gönderilir
# live        -> tam otomatik (önerilmez, en az birkaç haftalık signal_only/manual_confirm sonrası)
BIST_EXECUTION_MODE=signal_only

# --- Sermaye dağılımı (bilgi amaçlı — risk yöneticisi bütçelerini buradan türetir) ---
BIST_ALLOCATION_PCT=65
US_ALLOCATION_PCT=35

# --- ABD (us_equity) risk limitleri: aktif, stop-loss'lu işlem tarzı ---
MAX_POSITION_SIZE_USD=100
MAX_DAILY_LOSS_USD=25

# --- BIST risk limiti: uzun vadeli, "biriktirerek pozisyon oluşturma" tarzı ---
# Tek seferlik büyük alım yerine aylık bir üst sınır - stop-loss mantığı burada kullanılmaz.
MAX_BIST_MONTHLY_CONTRIBUTION_USD=100

GLOBAL_KILL_SWITCH=true   # true iken hiçbir gerçek emir gönderilmez
